# PharmaPulse Postgres warehouse -- read from `marts`, write to `ml` only.
# Same instance as the PharmaPulse project (docker-compose there owns the container).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pharmapulse
POSTGRES_USER=pharmapulse_user
POSTGRES_PASSWORD=changeme

# MLflow tracking (M2+) -- local file-backed store under ./mlruns by default.
MLFLOW_TRACKING_URI=file:./mlruns
